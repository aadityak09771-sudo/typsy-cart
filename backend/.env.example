# ========================================================
# TIPSYCART PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env for local development or set these
# variables in your hosting provider (e.g. Render Dashboard).
# NEVER commit real credentials or secrets to version control.
# ========================================================

# Django Core Security
# Generate a cryptographically secure 50+ character key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secure-production-django-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Custom Domain (e.g. tipsycart.in)
# Automatically configures ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS
CUSTOM_DOMAIN=yourdomain.com

# Allowed Hosts (comma-separated list of hostnames allowed to serve requests)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,yourdomain.com,www.yourdomain.com

# CSRF Trusted Origins (comma-separated list of origins allowed to submit forms)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://yourdomain.com,https://www.yourdomain.com

# Database Connection String
# On Render: Auto-injected from PostgreSQL database instance
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://tipsycart_user:password@hostname.oregon-postgres.render.com/tipsycart_db

# Email / Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Verified domain sender address (requires domain verification at https://resend.com/domains)
DEFAULT_FROM_EMAIL=TipsyCart <noreply@yourdomain.com>

# Email OTP Security Configuration
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Optional SMTP Fallback Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional Payment Gateway Secrets (e.g. Razorpay / PhonePe when integrated)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
